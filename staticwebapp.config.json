{
  "routes": [
    {
      "route": "/apple-app-site-association",
      "rewrite": "/apple-app-site-association.json"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.css",
      "/*.html",
      "/*.js",
      "/*.json",
      "/*.png",
      "/mockistar",
      "/mockistar/*"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
